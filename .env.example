# =============================================================================
# PESO Kabankalan Referral System — backend environment (VPS / Supabase build)
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# =============================================================================

# --- Core ---------------------------------------------------------------------
NODE_ENV=production
PORT=5000
# Long random string; used to sign JWTs. Generate with: openssl rand -hex 48
JWT_SECRET=

# Public URL of the SPA (used for e-mail links, OAuth redirects, CORS).
FRONTEND_URL=https://pesokabankalan.tech
# Comma-separated allow-list of browser origins for CORS + the Socket.IO
# handshake. If unset, FRONTEND_URL is used. Include every origin the SPA is
# served from (apex + www + any staging subdomain).
CORS_ORIGINS=https://pesokabankalan.tech,https://www.pesokabankalan.tech
# Absolute base the backend advertises for its own API in outbound e-mails.
PUBLIC_API_URL=https://pesokabankalan.tech

# Worker ownership on this host:
#   unset / all → this process runs the API AND the background workers in-process
#   web         → API only; run the workers in a separate `node worker.js` process
# On a single-VPS PM2 deploy, run the API as `web` and workers via `worker.js`
# (see ecosystem.config.js) so a worker crash never takes the API down.
WORKER_MODE=all

# --- Database -----------------------------------------------------------------
# This build targets PostgreSQL (Supabase). DB_CLIENT selects the driver:
#   postgres → the pg adapter (dbPgAdapter.js)   [this deployment]
#   mysql    → mysql2 against TiDB/MySQL          [original production]
DB_CLIENT=postgres
# Supabase connection string. Use the SESSION POOLER URI (IPv4-friendly) from
# Supabase → Project Settings → Database → Connection string. TLS is required;
# do NOT set DB_SSL=false for Supabase.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DB_SSL=true

# --- Database (MySQL/TiDB alternative — leave unset when DB_CLIENT=postgres) ---
# DB_CLIENT=mysql
# DB_HOST=
# DB_PORT=4000
# DB_USER=
# DB_PASSWORD=
# DB_NAME=job_tracker
# DB_SSL=true
# DB_INIT_ON_BOOT=false   # mysql only: run initDB() at boot (migrations own the schema)

# --- Google OAuth & sign-in ---------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an Authorized redirect URI in the Google Cloud console exactly.
GOOGLE_REDIRECT_URI=https://pesokabankalan.tech/api/auth/google/callback

# --- E-mail (primary transport) ----------------------------------------------
# Render blocks SMTP; on a VPS SMTP is available, but the app also supports the
# Brevo/Resend HTTP providers. Set the pair your provider needs.
EMAIL_USER=
EMAIL_PASS=
EMAIL_APP_PASSWORD=
EMAIL_OUTBOX_ENABLED=true

# --- E-mail (HTTP provider — Brevo, domain sender) ---------------------------
# LEADS the mailService provider chain when set. Send from your authenticated
# domain (better deliverability + official identity) instead of a gmail sender.
# Authenticate pesokabankalan.tech in Brevo (DKIM/SPF/DMARC DNS at name.com), then:
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@pesokabankalan.tech
BREVO_FROM_NAME=PESO Kabankalan
# (Resend is an alternative: RESEND_API_KEY + RESEND_FROM=noreply@pesokabankalan.tech)

# --- E-mail (fallback transport) ---------------------------------------------
EMAIL_FALLBACK_HOST=
EMAIL_FALLBACK_PORT=587
EMAIL_FALLBACK_USER=
EMAIL_FALLBACK_PASS=
EMAIL_FALLBACK_FROM=
EMAIL_FALLBACK_SECURE=false

# --- AI & translation ---------------------------------------------------------
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
DEEPL_API_KEY=
AI_SCORING_PREFER=deepseek
AI_SCORING_TIMEOUT_MS=45000
APPLICATION_SCORING_ENABLED=true
SCORING_INPUT_HASH_GUARD=true

# --- Referral pipeline / workers ---------------------------------------------
REFERRAL_WORKER_ENABLED=true
REFERRAL_WORKER_INTERVAL_MS=5000
REFERRAL_WORKER_BATCH_SIZE=5
REFERRAL_WORKER_STALE_SECONDS=120
REFERRAL_AI_THRESHOLD=70
REFERRAL_LIFECYCLE_SYNC_ENABLED=true
PROACTIVE_REFERRALS_ENABLED=true
PROACTIVE_INPUT_HASH_GUARD=true
PROACTIVE_REMATCH_ON_EDIT=true
JOB_ALERTS_ENABLED=true

# --- Automation (Make.com — sole provider) -----------------------------------
# Referral dispatch webhook. If unset, dispatch is a no-op and referrals still
# complete normally. (The retired n8n N8N_* vars must NOT be re-added.)
AUTOMATION_WEBHOOK_URL=
AUTOMATION_DISPATCH_TIMEOUT_MS=15000

# --- SMS (optional; disabled unless a provider is configured) -----------------
SMS_PROVIDER=
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
# Semaphore / Twilio are also supported — see services for the exact var names.

# --- Object storage -----------------------------------------------------------
# STORAGE_DRIVER selects where uploaded binaries live:
#   'local'    → ./uploads (public) + ./storage/private (PII). Durable on a VPS disk
#                but NOT backed up; on this driver PII (résumés) stays base64-in-DB.
#   'supabase' → Supabase Storage (S3-compatible): PUBLIC bucket 'avatars' + PRIVATE
#                bucket 'resumes'. Off the 500MB DB cap, backed by Supabase. [this deploy]
#   'r2'       → Cloudflare R2 (S3-compatible).
STORAGE_DRIVER=local
#
# Supabase Storage (when STORAGE_DRIVER=supabase). Generate the two keys in the
# dashboard → Project Settings → Storage → S3 Access Keys. Buckets are pre-created by
# `node scripts/provision-supabase-storage.js` (avatars=public, resumes=private).
SUPABASE_S3_ENDPOINT=https://xdtmyjknyimuxohalzyo.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-southeast-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_PUBLIC_BASE=https://xdtmyjknyimuxohalzyo.supabase.co/storage/v1/object/public
SUPABASE_BUCKET_PUBLIC=avatars
SUPABASE_BUCKET_PRIVATE=resumes
#
# Cloudflare R2 (when STORAGE_DRIVER=r2) — optional alternative
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_PRIVATE_BUCKET=
