# =============================================================================
# PESO Kabankalan Referral System — frontend (Vite) environment
# Copy to `.env` and fill in. Vite only exposes vars prefixed with VITE_.
# NEVER commit the real `.env`. These values are baked into the build.
# =============================================================================

# Base URL of the backend API, INCLUDING the /api suffix.
# Same-origin VPS deploy (SPA + API behind one Nginx host):
VITE_API_URL=https://pesokabankalan.tech/api

# Google OAuth client ID (public identifier — not the secret).
VITE_GOOGLE_CLIENT_ID=

# Optional tuning (safe defaults exist in code if omitted).
VITE_API_TIMEOUT_MS=60000
VITE_PIPELINE_POLL_MS=15000
